# Neon Postgres — every environment, including local dev. Each dev uses their own
# Neon branch; dev/prod parity is deliberate. Keep the ?sslmode=require suffix.
DATABASE_URI=postgres://user:password@host.neon.tech/dbname?sslmode=require

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Cloudflare R2 (optional). All five present switches uploads from local disk to R2.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# Email (optional). All three of HOST/USER/PASS switch Payload from logging mail to the
# console to actually sending it. Without them, password resets silently do nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@smuxplorationcrew.sg

# Absolute site URL, used by the sitemap and social preview cards. On Vercel this is
# derived automatically; set it only for a custom domain.
SITE_URL=

